# ----- Backend (apps/api) -----

# Anthropic API key for the chat layer
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Anthropic model — pinned for reproducibility
ANTHROPIC_MODEL=claude-sonnet-4-6

# Hard spending guard (rough; the real cap lives on the Anthropic console)
LLM_DAILY_USD_BUDGET=10

# CORS — frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Where DuckDB files live
DATA_DIR=./data/datasets

# Path to M5 calibration artifacts (relative to apps/api)
M5_ARTIFACTS_DIR=./m5/artifacts

# Single-password gate (frontend cookie, backend bypass)
# Leave blank in dev; set in prod
DEMO_PASSWORD=

# Sentry — optional, enable in prod
SENTRY_DSN=

# ----- Frontend (apps/web) -----

# Server-side only (NOT exposed to the browser). The Next.js /api/* proxy forwards here.
# Locally: http://localhost:8000  (uvicorn)
# Vercel:  set this to the Modal HTTPS URL printed by `modal deploy`
MODAL_API_URL=http://localhost:8000

# Optional fallback for direct calls (rare). Browser-visible.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Same DEMO_PASSWORD as above; gates the app
NEXT_PUBLIC_DEMO_REQUIRES_PASSWORD=false

# ----- Build-time only -----

# Kaggle credentials are loaded by the kaggle CLI from ~/.kaggle/kaggle.json
# We do NOT read them in this app at runtime.
